# ==========================================
# IMovies Backend Environment Configuration
# ==========================================

# Environment mode ('development', 'production', or 'test')
NODE_ENV=production

# Server port (used for local development; Vercel serverless manages its own port)
PORT=5000

# Trusted Frontend Origin for CORS
# For local development: http://localhost:5173
# For Vercel production: https://<your-frontend-project>.vercel.app
# Multiple origins can be comma-separated: https://imovies.vercel.app,https://your-custom-domain.com
CLIENT_URL=https://your-frontend-project.vercel.app

# MongoDB Atlas Connection URI (Required in Production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 (required for Vercel dynamic IPs)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/imovies?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong, 64-character random string in production)
JWT_SECRET=generate_a_secure_random_production_jwt_secret_key_here

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Seat hold duration in minutes before automatic release
HOLD_EXPIRY_MINUTES=8

# Seed Data Credentials (Optional for seeding demo data)
ADMIN_SEED_EMAIL=admin@imovies.com
ADMIN_SEED_PASSWORD=Admin@12345
USER_SEED_EMAIL=user@imovies.com
USER_SEED_PASSWORD=User@12345
